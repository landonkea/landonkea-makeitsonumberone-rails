# Copy this file to .env and fill in real values. .env itself is gitignored —
# it never gets committed — so this .env.example file is the only place
# real config keys are documented for whoever sets this project up next.

# Required. Your Anthropic API key, get one at https://console.anthropic.com/
# Without this set, every request to POST /api/command will fail with a
# clear "ANTHROPIC_API_KEY is not set" error instead of a confusing crash.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Which Claude model to call. Defaults to claude-sonnet-4-20250514
# (the same model the desktop client uses) if you don't set this.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
